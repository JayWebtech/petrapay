{
  "name": "petrapay",
  "version": "0.1.0",
  "description": "Accept any crypto and settle to shielded Zcash. Drop-in PetraPay checkout button and popup for any website, with React and script-tag builds.",
  "license": "MIT",
  "author": "Jethro Adamu",
  "homepage": "https://www.petrapay.xyz/docs/sdk",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JayWebtech/petrapay.git",
    "directory": "packages/petrapay-js"
  },
  "bugs": "https://github.com/JayWebtech/petrapay/issues",
  "keywords": [
    "petrapay",
    "zcash",
    "zec",
    "shielded",
    "crypto",
    "payments",
    "checkout",
    "stripe",
    "privacy",
    "usdc",
    "react"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/petrapay.global.js"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/petrapay.global.js",
  "jsdelivr": "./dist/petrapay.global.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react.d.ts",
        "default": "./dist/react.js"
      },
      "require": {
        "types": "./dist/react.d.cts",
        "default": "./dist/react.cjs"
      }
    },
    "./global": "./dist/petrapay.global.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "prepublishOnly": "pnpm run typecheck && pnpm run build && pnpm run test"
  },
  "peerDependencies": {
    "react": ">=17"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^19.2.0",
    "react": "^19.2.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
