// PetraPay data model.
//
// The platform is non-custodial: it never holds keys or funds. It stores invoice metadata,
// the creator's pool of shielded receiving addresses, and a mirror of each 1Click swap's status.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// A creator is identified only by an ed25519 public key generated in their browser.
/// No email, password, or wallet address is collected.
model Creator {
  id          String   @id @default(cuid())
  publicKey   String   @unique
  displayName String?
  /// X25519 public key payers encrypt form responses to. The private half never leaves the creator's browser.
  boxPublicKey String?
  invoiceSeq  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sessions  Session[]
  addresses ShieldedAddress[]
  invoices  Invoice[]
  swaps     Swap[]
  links     PaymentLink[]

  apiKeys          ApiKey[]
  webhookEndpoints WebhookEndpoint[]
  webhookEvents    WebhookEvent[]
  idempotencyKeys  IdempotencyKey[]
}

model AuthChallenge {
  nonce     String   @id
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  creatorId String
  creator   Creator  @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([creatorId])
}

/// Unified addresses (with an Orchard receiver) that invoices settle to.
/// Each new invoice takes an unused address so invoices can't be linked to each other
/// through the recipient field that NEAR Intents' public explorer displays.
model ShieldedAddress {
  id             String    @id @default(cuid())
  creatorId      String
  creator        Creator   @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  address        String
  label          String?
  hasOrchard     Boolean
  hasSapling     Boolean
  hasTransparent Boolean
  isDefault      Boolean   @default(false)
  assignedAt     DateTime?
  createdAt      DateTime  @default(now())

  invoices Invoice[]

  @@unique([creatorId, address])
  @@index([creatorId, assignedAt])
}

enum InvoiceStatus {
  OPEN
  PROCESSING
  PAID
  CANCELLED
  /// A checkout whose expiresAt passed with no live quote. Money that still arrives marks it PAID.
  EXPIRED
}

enum InvoiceSource {
  DASHBOARD
  API
  LINK
}

enum Currency {
  USD
  ZEC
}

model Invoice {
  /// Public, unguessable id used in the payment link.
  id                String        @id
  number            Int
  creatorId         String
  creator           Creator       @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  title             String
  description       String?
  /// Private note for the creator. Never shown on the payment page. (Legacy: new invoices use clientName/clientEmail.)
  clientLabel       String?
  /// Optional "billed to" details, shown on the payment page.
  clientName        String?
  clientEmail       String?
  editedAt          DateTime?
  lineItems         Json
  currency          Currency
  amount            Decimal       @db.Decimal(30, 8)
  status            InvoiceStatus @default(OPEN)
  addressId         String
  address           ShieldedAddress @relation(fields: [addressId], references: [id], onDelete: Restrict)
  addressReused     Boolean       @default(false)
  dueDate           DateTime?
  paidAt            DateTime?
  receivedZats      BigInt?
  receivedUsd       Decimal?      @db.Decimal(20, 2)
  payerMarkedPaidAt DateTime?
  cancelledAt       DateTime?
  /// Set when this invoice was created by a payer through a payment link.
  linkId            String?
  link              PaymentLink?  @relation(fields: [linkId], references: [id], onDelete: SetNull)
  /// Form responses sealed to the creator's box key in the payer's browser ("box1:…").
  responses         String?
  source            InvoiceSource   @default(DASHBOARD)
  /// Merchant's own identifier (e.g. an order id), set through the API.
  reference         String?
  /// Merchant key/value pairs, echoed back in the API and webhooks.
  metadata          Json?
  /// Where the hosted checkout sends the customer after paying / when they back out.
  successUrl        String?
  cancelUrl         String?
  /// After this, no new quotes are issued and the checkout becomes EXPIRED.
  expiresAt         DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  swaps Swap[]

  @@unique([creatorId, number])
  @@index([creatorId, status])
  @@index([linkId])
  @@index([creatorId, reference])
  @@index([status, expiresAt])
}

enum LinkAmountType {
  FIXED
  CUSTOM
}

/// A reusable checkout: fixed or payer-chosen amount, plus fields to collect.
/// Each payment through it becomes its own invoice with a fresh shielded address.
model PaymentLink {
  /// Public, unguessable id used in /l/:id.
  id          String         @id
  creatorId   String
  creator     Creator        @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  title       String
  description String?
  currency    Currency
  amountType  LinkAmountType
  amount      Decimal?       @db.Decimal(30, 8)
  minAmount   Decimal?       @db.Decimal(30, 8)
  maxAmount   Decimal?       @db.Decimal(30, 8)
  /// Suggested amounts shown to the payer for CUSTOM links.
  presets     Json
  /// Fields to collect: [{ id, label, type, required, options? }]
  fields      Json
  active      Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  invoices Invoice[]

  @@index([creatorId])
}

enum SwapKind {
  INVOICE_PAYMENT
  WITHDRAWAL
}

enum SwapStatus {
  PENDING_DEPOSIT
  KNOWN_DEPOSIT_TX
  PROCESSING
  SUCCESS
  INCOMPLETE_DEPOSIT
  REFUNDED
  FAILED
  EXPIRED
}

/// A 1Click quote with a live deposit address: either a client paying an invoice
/// (any token -> shielded ZEC) or a creator withdrawing (ZEC -> any token).
model Swap {
  id                 String     @id @default(cuid())
  kind               SwapKind
  creatorId          String
  creator            Creator    @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  invoiceId          String?
  invoice            Invoice?   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  swapType           String
  originAsset        String
  destinationAsset   String
  amountIn           String
  amountInFormatted  String
  amountInUsd        String?
  amountOut          String
  amountOutFormatted String
  amountOutUsd       String?
  recipient          String
  refundTo           String
  depositAddress     String
  depositMemo        String?
  /// Pay-by time we requested. After it, 1Click refunds instead of swapping.
  deadline           DateTime
  /// When 1Click stops watching the deposit address.
  inactiveAt         DateTime
  timeEstimate       Int?
  confidentiality    String
  correlationId      String
  /// Full signed quote response, kept to resolve disputes with 1Click.
  quoteResponse      Json
  status             SwapStatus @default(PENDING_DEPOSIT)
  depositTxHash      String?
  swapDetails        Json?
  lastCheckedAt      DateTime?
  /// When the deposit was first seen; the payer's "usually done in 15 minutes" timer starts here.
  detectedAt         DateTime?
  settledAt          DateTime?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  @@unique([depositAddress, depositMemo])
  @@index([status, lastCheckedAt])
  @@index([invoiceId])
  @@index([creatorId, kind])
}

/// Secret key a merchant's server uses for the public /v1 API. Only a hash is stored.
model ApiKey {
  id         String    @id @default(cuid())
  creatorId  String
  creator    Creator   @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  name       String
  /// SHA-256 of the full key.
  hash       String    @unique
  /// Last characters, to tell keys apart in the dashboard.
  lastFour   String
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([creatorId])
}

/// A merchant URL that receives signed event notifications.
model WebhookEndpoint {
  /// "we_…"
  id          String            @id
  creatorId   String
  creator     Creator           @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  url         String
  description String?
  /// Shared HMAC secret ("whsec_…") the merchant uses to verify signatures.
  secret      String
  /// Event types to send, or ["*"] for all.
  events      String[]
  active      Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  deliveries WebhookDelivery[]

  @@index([creatorId])
}

/// Something that happened to a merchant's checkout, as delivered to their webhooks.
model WebhookEvent {
  /// "evt_…"
  id        String            @id
  creatorId String
  creator   Creator           @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  type      String
  /// The full event body sent to endpoints.
  payload   Json
  createdAt DateTime          @default(now())

  deliveries WebhookDelivery[]

  @@index([creatorId, createdAt])
}

enum DeliveryStatus {
  PENDING
  SUCCEEDED
  FAILED
}

/// One event to one endpoint, retried with backoff until it gets a 2xx.
model WebhookDelivery {
  id             String          @id @default(cuid())
  eventId        String
  event          WebhookEvent    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  endpointId     String
  endpoint       WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  status         DeliveryStatus  @default(PENDING)
  attempts       Int             @default(0)
  nextAttemptAt  DateTime        @default(now())
  lastAttemptAt  DateTime?
  responseStatus Int?
  /// First 1,000 characters of the endpoint's reply, or the network error.
  responseBody   String?
  createdAt      DateTime        @default(now())

  @@index([status, nextAttemptAt])
  @@index([endpointId, createdAt])
}

/// Replays the first response for a repeated Idempotency-Key, so retried API calls don't create duplicates.
model IdempotencyKey {
  creatorId   String
  creator     Creator  @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  key         String
  /// SHA-256 of method + path + body; reusing a key with a different request is an error.
  requestHash String
  statusCode  Int
  body        Json
  createdAt   DateTime @default(now())

  @@id([creatorId, key])
}
