# Postgres (docker compose up -d postgres exposes it on 5433)
DATABASE_URL="postgresql://petrapay:petrapay@localhost:5433/petrapay"

PORT=4000
# Origin of the web app, used for CORS and payment links
APP_ORIGIN="http://localhost:3000"
# Set to true behind HTTPS
COOKIE_SECURE=false

# --- NEAR Intents 1Click ---
ONECLICK_BASE_URL="https://1click.chaindefuser.com"
# Partner JWT from https://partners.near-intents.org — avoids the extra 0.25% unauthenticated fee
# and is required for confidential quotes.
ONECLICK_JWT=""
# public | basic | advanced. basic/advanced route swaps through Confidential Intents so the
# payer's deposit can't be matched to the creator's withdrawal. Requires ONECLICK_JWT.
ONECLICK_CONFIDENTIALITY="public"
# Referral id sent with quotes
ONECLICK_REFERRAL="petrapay"
# Slippage in basis points (100 = 1%)
SLIPPAGE_BPS=100

# Optional platform fee, charged in the input token. 0 disables it.
APP_FEE_BPS=0
# NEAR Intents account that receives the fee (e.g. yourname.near)
APP_FEE_RECIPIENT=""

# Allow http:// and localhost/private webhook URLs, for testing webhooks locally. Never enable in production.
WEBHOOK_ALLOW_PRIVATE=false

# Background status poller
WORKER_ENABLED=true
POLL_INTERVAL_MS=8000
