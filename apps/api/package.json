{
  "name": "@petrapay/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsup",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "node --env-file-if-exists=.env --import tsx --import ./test/setup.ts --test --test-concurrency=1 test/*.test.ts",
    "db:migrate": "prisma migrate dev && prisma generate",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@defuse-protocol/one-click-sdk-typescript": "^0.1.26",
    "@fastify/cookie": "^11",
    "@fastify/cors": "^11",
    "@fastify/rate-limit": "^11.2.0",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@petrapay/shared": "workspace:^",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "dotenv": "^18.0.4",
    "fastify": "^5.6.1",
    "pino-pretty": "^13.1.3",
    "zod": "^4.3.3"
  },
  "devDependencies": {
    "@types/node": "^22",
    "prisma": "7.10.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
